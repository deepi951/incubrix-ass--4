# Keep simulation enabled unless a real, owned target has been explicitly approved.
SIMULATION_MODE=true
DATABASE_PATH=data/incubrix.db
LOG_LEVEL=INFO
MAX_CATALOGUE_IMPORT_BYTES=20000000
MAX_JOB_ATTEMPTS=5
JOB_STALE_AFTER_SECONDS=300
RECERTIFICATION_ENABLED=false
RECERTIFICATION_INTERVAL_SECONDS=86400

# Real certification gates (leave unset for local simulation).
# REAL_CERTIFICATION_ENABLED=false
# ALLOW_REAL_CERTIFICATION=false
